# Copy to .env and fill in from Supabase → Project Settings → API
# Production project ref is dyynbzbpitjoyfrxnxux (see supabase/config.toml)
VITE_SUPABASE_URL=https://dyynbzbpitjoyfrxnxux.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Optional — reverse geocoding for route stop names (Nominatim).
# Contact address sent with each lookup, as the OSM usage policy asks.
# VITE_NOMINATIM_EMAIL=ops@example.com
# Own Nominatim instance; defaults to https://nominatim.openstreetmap.org/reverse
# VITE_NOMINATIM_URL=https://geo.example.com/reverse

# Optional — crash reporting. Unset means no reporting at all, no requests made.
# DSN from Sentry → Project Settings → Client Keys.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
# Labels the events; defaults to the Vite mode (development / production).
# VITE_SENTRY_ENVIRONMENT=production
# Version string events are tagged with, e.g. the commit sha.
# VITE_SENTRY_RELEASE=v0.1.0
